# Settings for `docker compose`: cp .env.example .env, then replace every "change-me".
# Local runs without Docker need none of this (DEBUG on, SQLite, in-process cache).

# --- Secrets ------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Goes into DATABASE_URL, so use URL-safe characters (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me

# --- Django -------------------------------------------------------------------
DJANGO_DEBUG=False
# Keep localhost: the container healthcheck calls http://localhost:8000/api/health/live/.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Scheme + host, e.g. https://tasks.example.com (needed for the admin over HTTPS).
DJANGO_CSRF_TRUSTED_ORIGINS=
# The admin login is not rate limited: enable only behind HTTPS and a VPN or IP allowlist.
DJANGO_ADMIN_ENABLED=0
DJANGO_ADMIN_URL=admin/
DJANGO_LOG_LEVEL=INFO
DJANGO_CONN_MAX_AGE=60
# PostgreSQL statement_timeout for the app, ms; 0 = none (the migrate service uses 0).
DJANGO_DB_STATEMENT_TIMEOUT_MS=5000
# 0 lets a separate release step run migrations instead of the web container.
DJANGO_MIGRATE=1

# --- HTTPS (enable once TLS terminates in front of the app) ---------------------
DJANGO_SECURE_HTTPS=0
# 1 only behind a proxy that always overwrites X-Forwarded-Proto.
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# --- Throttling ---------------------------------------------------------------
THROTTLE_ANON_RATE=100/hour
THROTTLE_USER_RATE=1000/hour
# Registration, token, refresh and logout, per client IP.
THROTTLE_AUTH_RATE=10/min
# Token requests per target username, from any IP.
THROTTLE_AUTH_ACCOUNT_RATE=20/hour
# Number of reverse proxies in front of the app (0 = clients connect directly).
NUM_PROXIES=0

# --- Error tracking -----------------------------------------------------------
# Sentry DSN; empty disables error reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Share of requests traced for performance monitoring, 0..1.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Gunicorn -----------------------------------------------------------------
# Default: min(2 * CPU + 1, 4).
GUNICORN_WORKERS=
GUNICORN_THREADS=4
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- Compose ------------------------------------------------------------------
HTTP_PORT=8000
POSTGRES_DB=tasks
POSTGRES_USER=tasks
