# docker compose settings: cp .env.example .env and replace every change-me.
# Local runs without Docker need none of this. Full list: docs/operations.md.

# Public host name. Caddy gets a certificate for it.
DOMAIN=localhost
# acme: Let's Encrypt (DOMAIN resolves to this host, ports 80 and 443 open).
# internal: Caddy's own CA, for CI and local runs.
CADDY_TLS=internal

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Goes into DATABASE_URL: use URL-safe characters, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me

DJANGO_DEBUG=False
# Caddy terminates TLS, always sets X-Forwarded-Proto and appends the client address
# to X-Forwarded-For.
DJANGO_SECURE_HTTPS=1
DJANGO_SECURE_PROXY_SSL_HEADER=1
NUM_PROXIES=1
