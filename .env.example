# Optional overrides for `docker compose` (copy to .env). Local runs work without
# any of these: DEBUG is on and SQLite is used by default.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Outside docker compose, point to PostgreSQL like this:
# DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks
