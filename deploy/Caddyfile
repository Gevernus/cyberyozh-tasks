# TLS edge for the API. Environment:
#   DOMAIN     public host name; Caddy obtains its certificate from Let's Encrypt
#   CADDY_TLS  "acme" (default) or "internal": a certificate from Caddy's own CA,
#              for CI and local runs where Let's Encrypt cannot reach the host

(tls_acme) {
}

(tls_internal) {
	tls internal
}

{$DOMAIN} {
	import tls_{$CADDY_TLS:acme}

	encode zstd gzip

	request_body {
		max_size 1MB
	}

	# Internal only: Prometheus scrapes web:8000/metrics inside the network.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# "?" fills a header only where Django did not set it, e.g. on responses Caddy
	# makes itself (413, 502), so Django's HSTS options stay in force.
	# The CSP admits Swagger UI, Redoc and the browsable API; JSON ignores it.
	header {
		defer
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.redoc.ly; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	reverse_proxy {
		# Every web replica (docker compose up --scale web=N) is a separate upstream,
		# re-resolved from Docker's DNS.
		dynamic a web 8000 {
			refresh 5s
		}
		lb_policy least_conn
		# A request that cannot reach a replica is retried on another for up to 5s.
		# Retries happen after connection failures, and for GET after any failure.
		lb_try_duration 5s
		lb_try_interval 250ms
		# Caddy runs no active health checks for dynamic upstreams. Passively, a
		# replica with 5 failed requests within 10s is skipped for the rest of it.
		fail_duration 10s
		max_fails 5

		transport http {
			# Shorter than gunicorn's keepalive (5s): the proxy drops an idle
			# connection before the app does, so it never reuses a closed one.
			keepalive 3s
		}

		# The client address as Caddy saw it, never a value sent by the client. Caddy
		# does this by default; pinned here so it holds even if trusted_proxies is set.
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output stdout
		format json
	}
}
