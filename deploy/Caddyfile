# DOMAIN: the public host name. CADDY_TLS: acme (Let's Encrypt, the default) or
# internal (Caddy's own CA, for CI and local runs).

(tls_acme) {
}

(tls_internal) {
	tls internal
}

{$DOMAIN} {
	import tls_{$CADDY_TLS:acme}

	encode zstd gzip

	request_body {
		max_size 1MB
	}

	# Scraped as web:8000/metrics inside the network.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# "?" sets a header only where Django did not, e.g. on Caddy's own 413 and 502.
	# The CSP admits Swagger UI and Redoc.
	header {
		defer
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.redoc.ly; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	reverse_proxy {
		# Every web replica, re-resolved from Docker's DNS.
		dynamic a web 8000 {
			refresh 5s
		}
		lb_policy least_conn
		# Retry on another replica for up to 5s: after connection failures, and for
		# GET after any failure.
		lb_try_duration 5s
		lb_try_interval 250ms
		# No active health checks for dynamic upstreams; 5 failures in 10s eject a replica.
		fail_duration 10s
		max_fails 5

		transport http {
			# Shorter than gunicorn's 5s, so Caddy never reuses a connection gunicorn closed.
			keepalive 3s
		}

		# The client address as Caddy saw it, even if trusted_proxies is ever set.
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output stdout
		format json
	}
}
